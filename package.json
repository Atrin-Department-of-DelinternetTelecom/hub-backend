{
  "name": "hrms",
  "version": "1.0.0",
  "description": "Human Resource Management System",
  "main": "src/server.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "TZ=Europe/Madrid node -r ts-node/register src/server",
    "start:swc": "TZ=Europe/Madrid SWCRC=true node -r @swc-node/register src/server",
    "start:dev": "NODE_PATH=development TZ=Europe/Madrid node --watch -r ts-node/register src/server",
    "start:fake": "TZ=Europe/Madrid LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1 FAKETIME='2025-11-01 10:00:00' node -r ts-node/register src/server",
    "windows-reset": "node ./scripts/windows-reset.js",
    "nodemon": "TZ=Europe/Madrid node ./scripts/nodemon.js",
    "linux-reset": "node ./scripts/linux-reset.js",
    "refresh": "node ./scripts/refresh.js",
    "linux-clean": "node ./scripts/linux-clean.js",
    "linux-clean-web": "node ./scripts/clean-web.js",
    "lint": "eslint src tests",
    "lint:quiet": "eslint src tests --quiet --cache",
    "migrate:system": "node -r ts-node/register ./node_modules/.bin/sequelize --options-path=sequelizerc.system.js --env system db:migrate",
    "migrate:system:dev": "NODE_ENV=development npm run migrate:system",
    "migrate:system:test": "NODE_ENV=test npm run migrate:system",
    "migrate:intranet": "node -r ts-node/register ./node_modules/.bin/sequelize --options-path=sequelizerc.intranet.js --env intranet db:migrate",
    "migrate:intranet:dev": "NODE_ENV=development npm run migrate:intranet",
    "migrate:intranet:test": "NODE_ENV=test npm run migrate:intranet",
    "migrate": "npm run migrate:system && npm run migrate:intranet",
    "migrate:dev": "NODE_ENV=development npm run migrate",
    "migrate:test": "NODE_ENV=test npm run migrate",
    "migration:generate:system": "node -r ts-node/register ./node_modules/.bin/sequelize --options-path=sequelizerc.system.js migration:generate --name",
    "migration:generate:intranet": "node -r ts-node/register ./node_modules/.bin/sequelize --options-path=sequelizerc.intranet.js migration:generate --name",
    "seeder-dev": "export NODE_ENV=development & set NODE_ENV=development && node -r ts-node/register node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "test": "TZ=Europe/Madrid NODE_ENV=development node --max-old-space-size=8192 --expose-gc ./node_modules/.bin/jest --logHeapUsage --runInBand",
    "test:verbose": "TZ=Europe/Madrid jest --runInBand",
    "test:coverage": "TZ=Europe/Madrid jest --coverage --runInBand --silent",
    "format": "prettier --loglevel=error --write \"src/**/*.(js|ts|jsx|tsx)\" \"tests/**/*.(js|ts|jsx|tsx)\"",
    "format:check": "prettier --check --cache \"src/**/*.(js|ts|jsx|tsx)\" \"tests/**/*.(js|ts|jsx|tsx)\"",
    "prepare": "husky install"
  },
  "license": "",
  "private": true,
