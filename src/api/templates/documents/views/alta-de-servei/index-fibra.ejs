<% contract_type = "Prestació de servei d'accés a internet" %>
<div class="d-flex flex-column page"> 
    <%- include('../components/header') %>
    <%- include('../components/personal_info') %> 
    <div class="d-flex flex-column px-2 pb-2">
        <h2 class="pb-2">Servei Contractat</h2>
        <div class="d-flex flex-wrap">
            <div class="d-flex flex-column mb-2 w-100">
                <label class="text-gray uppercase">Tarifa</label>
                <p><%= fee_name %></p>
            </div>
            <div class="d-flex flex-column mb-2 w-75"> 
                <label class="text-gray uppercase">Adreça d'instal·lació</label>
                <p><%= installation_address %></p>
            </div>
            <div class="d-flex flex-column mb-2 w-25"> 
                <label class="text-gray uppercase">Codi Postal</label>
                <p><%= installation_CP %></p>
            </div> 
            <div class="d-flex flex-column mb-2 w-75">
                <label class="text-gray uppercase">Localitat</label>
                <p><%= installation_city %></p>
            </div>
            
            <div class="d-flex flex-column mb-2 w-25">
                <label class="text-gray uppercase">Provincia</label>
                <p><%= installation_region %></p>
            </div>  
        </div>
    </div> 
    <%- include('../components/footer', { observation: true }) %> 
</div>
<%- 
    include(`../components/${ 
        locale === 'es' 
            ? 'es_condiciones_contractacion' 
            : 'condicions_contractacio'
    }`) 
%> 
