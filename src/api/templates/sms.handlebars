<b class="label label-info">Unpaid Notification</b><br>
<br>
<button class='btn btn-xs pull-left' data-invoiceId=`{{id}}`>
    {{code}}&nbsp;<i class="fa fa-chevron-right" aria-hidden="true"></i>
</button>
<br>
<br>

<table class='table table-bordered'>
    <tr>
        <td>cutDate:</td>
        <td>{{cutDate}}</td>
    </tr>
    <tr>
        <td>sendDate:</td>
        <td>{{sendDate}}</td>
    </tr>
    <tr>
        <td>phone:</td>
        <td>{{phone}}</td>
    </tr>
    <tr>
        <td>name:</td>
        <td>{{clientName}}</td>
    </tr>
    <tr>
        <td>fee:</td>
        <td>{{unpaidFee}}</td>
    </tr>
    <tr>
        <td>total:</td>
        <td>{{total}}</td>
    </tr>
    <tr>
        <td>userName:</td>
        <td>{{ userName }}</td>
    </tr>
    <tr>
        <td>via:</td>
        <td>{{via}}</td>
    </tr>
     
</table>